{
  "schemaVersion": 1,
  "id": "nevvavisuals",
  "version": "${version}",
  "name": "NevvaVisuals",
  "description": "Client-side visual mod with a responsive two-column menu, customizable HUD, visual effects and Dark, White and Liquid Glass themes.",
  "authors": [
    "Nevva"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.nevva.visuals.NevvaVisuals"
    ]
  },
  "mixins": [
    "nevvavisuals.mixins.json"
  ],
  "accessWidener": "nevvavisuals.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": ">=0.110.0"
  }
}
